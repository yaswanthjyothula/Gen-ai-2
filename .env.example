# CRIMENET-X Environment Variables Template
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
API_PORT=8000
API_HOST=0.0.0.0
SECRET_KEY=crimenet-x-secret-key-production-change-me-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (Dual Mode: SQLite local / PostgreSQL Docker)
DATABASE_URL=sqlite:///./crimenet_x.db
# DATABASE_URL=postgresql://crimenet_admin:secret_password@localhost:5432/crimenet_x

# Neo4j Graph Database Configuration (Optional for native Cypher)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=investigation_secure_pass

# Investigation Default Context
DEFAULT_INVESTIGATION_ID=INV-2026-0147
DEFAULT_CASE_ID=CASE-0147

# Google Gemini Intelligence Brain
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
